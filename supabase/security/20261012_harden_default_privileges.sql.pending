-- REVIEW DRAFT ONLY. Separate from existing-table grants; outside migrations/.
-- Two verified creators, public schema, table defaults only. No remote approval.
BEGIN;
SET LOCAL lock_timeout = '5s';
SET LOCAL statement_timeout = '30s';
DO $defaults$
DECLARE
  creator text;
  target_role text;
  privilege_name text;
  before_state jsonb;
  after_state jsonb;
  before_tables jsonb;
  after_tables jsonb;
BEGIN
  IF current_setting('server_version_num')::integer / 10000 <> 17 THEN
    RAISE EXCEPTION 'Expected PostgreSQL 17';
  END IF;
  FOREACH creator IN ARRAY ARRAY['postgres', 'supabase_admin'] LOOP
    IF NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = creator) THEN
      RAISE EXCEPTION 'Missing verified creator: %', creator;
    END IF;
    -- A per-schema revoke cannot override a global grant. Do not broaden scope.
    IF EXISTS (
      SELECT 1 FROM pg_default_acl d, LATERAL aclexplode(d.defaclacl) a
      WHERE d.defaclrole = creator::regrole AND d.defaclnamespace = 0
        AND d.defaclobjtype = 'r' AND a.grantee IN
          (0, 'anon'::regrole, 'authenticated'::regrole)
        AND a.privilege_type IN ('TRUNCATE','TRIGGER','REFERENCES','MAINTAIN')
    ) THEN
      RAISE EXCEPTION 'Global structural defaults require separate approval: %', creator;
    END IF;
    FOREACH target_role IN ARRAY ARRAY['anon', 'authenticated'] LOOP
      FOREACH privilege_name IN ARRAY ARRAY['TRUNCATE','TRIGGER','REFERENCES','MAINTAIN'] LOOP
        IF NOT EXISTS (
          SELECT 1 FROM pg_default_acl d, LATERAL aclexplode(d.defaclacl) a
          WHERE d.defaclrole = creator::regrole
            AND d.defaclnamespace = 'public'::regnamespace
            AND d.defaclobjtype = 'r' AND a.grantee = target_role::regrole
            AND a.grantor = creator::regrole
            AND a.privilege_type = privilege_name AND NOT a.is_grantable
        ) THEN
          RAISE EXCEPTION 'Missing/drifted direct default: % % %',
            creator, target_role, privilege_name;
        END IF;
      END LOOP;
    END LOOP;
  END LOOP;

  SELECT jsonb_agg(to_jsonb(x) ORDER BY x::text) INTO before_state FROM (
    SELECT d.defaclrole, d.defaclnamespace, d.defaclobjtype, a.*
    FROM pg_default_acl d, LATERAL aclexplode(d.defaclacl) a
    WHERE NOT (d.defaclrole IN ('postgres'::regrole,'supabase_admin'::regrole)
      AND d.defaclnamespace='public'::regnamespace AND d.defaclobjtype='r'
      AND a.grantee IN ('anon'::regrole,'authenticated'::regrole)
      AND a.privilege_type IN ('TRUNCATE','TRIGGER','REFERENCES','MAINTAIN'))
  ) x;
  SELECT jsonb_agg(jsonb_build_array(oid, relacl::text) ORDER BY oid)
    INTO before_tables FROM pg_class;

  FOREACH creator IN ARRAY ARRAY['postgres', 'supabase_admin'] LOOP
    EXECUTE format('ALTER DEFAULT PRIVILEGES FOR ROLE %I IN SCHEMA public REVOKE TRUNCATE, TRIGGER, REFERENCES, MAINTAIN ON TABLES FROM anon, authenticated RESTRICT', creator);
  END LOOP;

  IF EXISTS (
    SELECT 1 FROM pg_default_acl d, LATERAL aclexplode(d.defaclacl) a
    WHERE d.defaclrole IN ('postgres'::regrole,'supabase_admin'::regrole)
      AND d.defaclnamespace='public'::regnamespace AND d.defaclobjtype='r'
      AND a.grantee IN ('anon'::regrole,'authenticated'::regrole)
      AND a.privilege_type IN ('TRUNCATE','TRIGGER','REFERENCES','MAINTAIN')
  ) THEN
    RAISE EXCEPTION 'Residual schema defaults; rollback';
  END IF;
  SELECT jsonb_agg(to_jsonb(x) ORDER BY x::text) INTO after_state FROM (
    SELECT d.defaclrole, d.defaclnamespace, d.defaclobjtype, a.*
    FROM pg_default_acl d, LATERAL aclexplode(d.defaclacl) a
  ) x;
  SELECT jsonb_agg(jsonb_build_array(oid, relacl::text) ORDER BY oid)
    INTO after_tables FROM pg_class;
  IF before_state IS DISTINCT FROM after_state
    OR before_tables IS DISTINCT FROM after_tables THEN
    RAISE EXCEPTION 'Unrelated defaults or existing ACLs changed; rollback';
  END IF;
END;
$defaults$;
COMMIT;
